<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>GRAVITY LAB</title>
<style>
:root{color-scheme:light;--ink:#111;--paper:#fff;--line:#ddd}
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#fff;color:#111;font-family:system-ui,sans-serif}
button{font:inherit;color:inherit;background:#fff;border:1px solid #bbb;border-radius:10px;padding:10px 13px;cursor:pointer}
button:active{background:#e9e9e9}
.app{height:100%;display:flex;flex-direction:column;max-width:1100px;margin:auto;padding:0 14px}
header{height:64px;flex-shrink:0;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);gap:12px}
.brand{font-size:13px;font-weight:850;letter-spacing:.16em}
.stageLabel{font-size:12px;color:#666;letter-spacing:.1em;margin-top:4px}
.timerBox{text-align:right;min-width:108px}
.timer{font-variant-numeric:tabular-nums;font-size:24px;font-weight:750;letter-spacing:.03em}
.timerCaption{font-size:9px;color:#777;letter-spacing:.18em;margin-top:5px}
main{flex:1;min-height:0;display:flex;flex-direction:column;padding:12px 0 10px;gap:10px}
canvas{display:block;width:100%;height:100%;background:#fff;touch-action:none}
.gameFrame{flex:1;min-height:120px;position:relative;overflow:hidden;border:1px solid #d7d7d7;border-radius:12px;background:#fff}
.canvasHud{position:absolute;left:12px;top:10px;display:flex;gap:7px;pointer-events:none}
.pill{background:rgba(255,255,255,.92);border:1px solid #ddd;border-radius:7px;padding:5px 8px;font-size:11px;color:#333}
.bottom{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;flex-shrink:0}
.status{font-size:12px;color:#666;min-height:18px}
.controls{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}
.controls button{font-size:12px;padding:9px 11px}
.primary{background:#111;color:#fff;border-color:#111}
.primary:active{background:#333}
.overlay{position:absolute;inset:0;background:rgba(255,255,255,.94);display:flex;align-items:center;justify-content:center;text-align:center;padding:20px;z-index:2}
.overlay[hidden]{display:none}
.dialog{max-width:330px;width:100%}
.dialog h1{font-size:25px;letter-spacing:.08em;margin:0 0 8px}
.dialog p{font-size:13px;line-height:1.6;color:#555;margin:0 0 18px}
.dialog .actions{display:flex;justify-content:center;gap:8px;flex-wrap:wrap}
.recordline{margin-top:13px;font-size:12px;color:#777}
.help{font-size:11px;color:#888;line-height:1.5}
@media(min-width:760px){.app{padding:0 22px}header{height:72px}.timer{font-size:27px}.gameFrame{border-radius:15px}main{padding-top:16px}.controls button{padding:10px 14px}}
@media(max-width:430px){.app{padding:0 9px}header{height:58px}.brand{font-size:12px}.timer{font-size:21px}.gameFrame{border-radius:9px}.bottom{align-items:flex-start}.controls{width:100%;justify-content:space-between}.controls button{flex:1;padding:9px 5px}.status{padding:2px 0}}
</style>
</head>
<body>
<div class="app">
  <header>
    <div>
      <div class="brand">GRAVITY LAB</div>
      <div class="stageLabel" id="stageLabel">STAGE 01</div>
    </div>
    <div class="timerBox">
      <div class="timer" id="timer">00:00.00</div>
      <div class="timerCaption">ELAPSED TIME</div>
    </div>
  </header>
  <main>
    <div class="gameFrame" id="gameFrame">
      <canvas id="game" aria-label="중력 미로 게임"></canvas>
      <div class="canvasHud">
        <span class="pill" id="levelSize">MAZE 9 × 9</span>
        <span class="pill" id="modePill">센서 대기</span>
      </div>
      <div class="overlay" id="overlay">
        <div class="dialog">
          <h1 id="overlayTitle">GRAVITY LAB</h1>
          <p id="overlayText">기기를 기울여 검은 공을 출구까지 이동하세요.<br>공을 움직이면 타이머가 시작됩니다.</p>
          <div class="actions">
            <button class="primary" id="startBtn">시작하기</button>
            <button id="sensorBtn">기울기 센서 사용</button>
          </div>
          <div class="recordline" id="overlayRecord">BEST —</div>
        </div>
      </div>
    </div>
    <div class="bottom">
      <div class="status" id="status">기울기 센서 또는 방향키로 조작하세요.</div>
      <div class="controls">
        <button id="restartBtn">↻ 재시작</button>
        <button id="pauseBtn">Ⅱ 일시정지</button>
        <button id="nextBtn" class="primary" hidden>다음 스테이지 →</button>
      </div>
    </div>
    <div class="help">모바일: 화면을 기울이세요 · PC: 방향키 / WASD · 스테이지별 기록 자동 저장</div>
  </main>
</div>
<script>
(() => {
'use strict';
const $ = id => document.getElementById(id);
const canvas = $('game'), ctx = canvas.getContext('2d');
const timerEl = $('timer'), stageLabel = $('stageLabel'), levelSizeEl = $('levelSize');
const modePill = $('modePill'), overlay = $('overlay');
const overlayTitle = $('overlayTitle'), overlayText = $('overlayText'), overlayRecord = $('overlayRecord');
const startBtn = $('startBtn'), sensorBtn = $('sensorBtn'), restartBtn = $('restartBtn');
const pauseBtn = $('pauseBtn'), nextBtn = $('nextBtn'), statusEl = $('status');
const SAVE_KEY = 'gravity-lab-save-v1';
let saved = {};
try { saved = JSON.parse(localStorage.getItem(SAVE_KEY) || '{}') || {}; } catch (_) {}
let stage = Math.max(1, Number(saved.stage) || 1);
let bests = saved.bests && typeof saved.bests === 'object' ? saved.bests : {};
let maze = null, cell = 32, worldW = 0, worldH = 0;
let ball = {x:0,y:0,vx:0,vy:0,r:8};
let camera = {x:0,y:0};
let started = false, paused = false, cleared = false, sensorActive = false;
let elapsed = 0, tiltX = 0, tiltY = 0, keyX = 0, keyY = 0;
let movesStarted = false, frameW = 800, frameH = 500, lastFrame = 0;

function saveProgress() {
  try { localStorage.setItem(SAVE_KEY, JSON.stringify({stage, bests})); } catch (_) {}
}
function fmtTime(sec) {
  sec = Math.max(0, sec || 0);
  const mins = Math.floor(sec / 60), secs = Math.floor(sec % 60), cs = Math.floor((sec % 1) * 100);
  return String(mins).padStart(2,'0') + ':' + String(secs).padStart(2,'0') + '.' + String(cs).padStart(2,'0');
}
function clamp(v,a,b){ return Math.max(a,Math.min(b,v)); }
function mazeSize(level) { return Math.min(41, 9 + Math.floor((level - 1) / 1.6) * 2) | 1; }

function makeMaze(n) {
  // DFS 미로: 모든 길이 연결되고 출발점부터 출구까지의 경로는 하나.
  const grid = Array.from({length:n}, () => Array(n).fill(1));
  const dirs = [[0,-2],[2,0],[0,2],[-2,0]];
  const stack = [[1,1]];
  grid[1][1] = 0;
  while(stack.length) {
    const [x,y] = stack[stack.length-1];
    const options = [];
    for(const [dx,dy] of dirs) {
      const nx=x+dx, ny=y+dy;
      if(nx>0 && ny>0 && nx<n-1 && ny<n-1 && grid[ny][nx]===1)
        options.push([nx,ny,dx,dy]);
    }
    if(!options.length) { stack.pop(); continue; }
    const [nx,ny,dx,dy] = options[Math.floor(Math.random()*options.length)];
    grid[y+dy/2][x+dx/2] = 0;
    grid[ny][nx] = 0;
    stack.push([nx,ny]);
  }
  grid[n-1][n-2] = 0;
  return {grid,n,start:{x:1,y:1},exit:{x:n-2,y:n-1}};
}
function resize() {
  const rect = canvas.getBoundingClientRect();
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  frameW = Math.max(1, rect.width);
  frameH = Math.max(1, rect.height);
  canvas.width = Math.round(frameW*dpr);
  canvas.height = Math.round(frameH*dpr);
  ctx.setTransform(dpr,0,0,dpr,0,0);
  draw();
}
function buildStage() {
  const n = mazeSize(stage);
  maze = makeMaze(n);
  cell = stage < 5 ? 36 : stage < 10 ? 33 : stage < 16 ? 30 : 28;
  worldW = maze.n*cell;
  worldH = maze.n*cell;
  ball.r = Math.max(6, cell*0.22);
  ball.x = (maze.start.x+0.5)*cell;
  ball.y = (maze.start.y+0.5)*cell;
  ball.vx = ball.vy = 0;
  camera.x = clamp(ball.x-frameW/2,0,Math.max(0,worldW-frameW));
  camera.y = clamp(ball.y-frameH/2,0,Math.max(0,worldH-frameH));
  started = false; paused = false; cleared = false; movesStarted = false;
  elapsed = 0;
  timerEl.textContent = fmtTime(elapsed);
  stageLabel.textContent = 'STAGE ' + String(stage).padStart(2,'0');
  levelSizeEl.textContent = `MAZE ${n} × ${n}`;
  pauseBtn.textContent = 'Ⅱ 일시정지';
  nextBtn.hidden = true;
  sensorBtn.hidden = false;
  overlay.hidden = false;
  overlayTitle.textContent = 'GRAVITY LAB';
  overlayText.innerHTML = '기기를 기울여 검은 공을 출구까지 이동하세요.<br>공을 움직이면 타이머가 시작됩니다.';
  startBtn.textContent = '시작하기';
  overlayRecord.textContent = 'BEST ' + (bests[stage] != null ? fmtTime(bests[stage]) : '—');
  statusEl.textContent = sensorActive ? '센서 연결됨 · 기기를 기울이세요.' : '방향키 / WASD 또는 기울기 센서로 조작하세요.';
  draw();
}
function setMode() {
  modePill.textContent = sensorActive ? '센서 연결' : '키보드 / 센서';
}
function showOverlay(title, message, buttonText='계속하기') {
  overlay.hidden=false;
  overlayTitle.textContent=title;
  overlayText.innerHTML=message;
  startBtn.textContent=buttonText;
  overlayRecord.textContent='BEST '+(bests[stage] != null ? fmtTime(bests[stage]) : '—');
}
function startGame() {
  if(cleared) return;
  overlay.hidden=true;
  paused=false;
  started=true;
  lastFrame=performance.now();
  statusEl.textContent=sensorActive ? '기기를 기울여 출구로 이동하세요.' : '방향키 / WASD로 공을 굴리세요.';
}
function togglePause() {
  if(cleared) return;
  if(!started) { startGame(); return; }
  paused=!paused;
  if(paused) {
    started=false;
    showOverlay('PAUSED','잠시 쉬어가도 좋아요.<br>계속하려면 아래 버튼을 누르세요.','계속하기');
    pauseBtn.textContent='▶ 계속';
  } else {
    overlay.hidden=true;
    started=true;
    lastFrame=performance.now();
    pauseBtn.textContent='Ⅱ 일시정지';
  }
}
function circleRectCollision(cx,cy,r,rx,ry,rw,rh) {
  const px=clamp(cx,rx,rx+rw), py=clamp(cy,ry,ry+rh);
  const dx=cx-px,dy=cy-py;
  return dx*dx+dy*dy < r*r;
}
function collidesAt(x,y) {
  const r=ball.r;
  const minX=Math.floor((x-r)/cell), maxX=Math.floor((x+r)/cell);
  const minY=Math.floor((y-r)/cell), maxY=Math.floor((y+r)/cell);
  for(let gy=minY;gy<=maxY;gy++) for(let gx=minX;gx<=maxX;gx++) {
    if(gx<0||gy<0||gx>=maze.n||gy>=maze.n||maze.grid[gy][gx]===1) {
      if(circleRectCollision(x,y,r,gx*cell,gy*cell,cell,cell)) return true;
    }
  }
  return false;
}
function updatePhysics(dt) {
  const ax=tiltX*900 + keyX*850;
  const ay=tiltY*900 + keyY*850;
  ball.vx += ax*dt;
  ball.vy += ay*dt;
  const damping = Math.exp(-2.05*dt);
  ball.vx *= damping;
  ball.vy *= damping;
  const maxV=cell*7, speed=Math.hypot(ball.vx,ball.vy);
  if(speed>maxV){ball.vx=ball.vx/speed*maxV;ball.vy=ball.vy/speed*maxV;}
  if(Math.abs(ax)+Math.abs(ay)<1 && Math.hypot(ball.vx,ball.vy)<5){ball.vx=0;ball.vy=0;}
  const nx=ball.x+ball.vx*dt;
  if(!collidesAt(nx,ball.y)) ball.x=nx;
  else {ball.vx *= -0.12;if(Math.abs(ball.vx)<12)ball.vx=0;}
  const ny=ball.y+ball.vy*dt;
  if(!collidesAt(ball.x,ny)) ball.y=ny;
  else {ball.vy *= -0.12;if(Math.abs(ball.vy)<12)ball.vy=0;}
  if(Math.hypot(ball.vx,ball.vy)>8) movesStarted=true;
  if(movesStarted) elapsed+=dt;

  const targetX=clamp(ball.x-frameW/2,0,Math.max(0,worldW-frameW));
  const targetY=clamp(ball.y-frameH/2,0,Math.max(0,worldH-frameH));
  camera.x += (targetX-camera.x)*Math.min(1,dt*5.5);
  camera.y += (targetY-camera.y)*Math.min(1,dt*5.5);

  const ex=(maze.exit.x+0.5)*cell, ey=(maze.exit.y+0.5)*cell;
  if(Math.hypot(ball.x-ex,ball.y-ey)<cell*0.34) clearStage();
}
function clearStage() {
  if(cleared) return;
  cleared=true; started=false; paused=false;
  const score=elapsed, old=bests[stage];
  const isBest=old==null || score<old;
  if(isBest) bests[stage]=score;
  saved.stage=Math.max(Number(saved.stage)||1,stage+1);
  saveProgress();
  nextBtn.hidden=false;
  pauseBtn.textContent='Ⅱ 일시정지';
  statusEl.textContent=isBest?'새 최고 기록!':'스테이지 클리어!';
  showOverlay('STAGE CLEAR',`기록 <b>${fmtTime(score)}</b><br>${isBest?'🎉 새로운 최고 기록입니다!':'최고 기록 '+fmtTime(bests[stage])}`, '다음 스테이지');
  sensorBtn.hidden=true;
  draw();
}
function nextStage() {
  stage++;
  saved.stage=Math.max(Number(saved.stage)||1,stage);
  saveProgress();
  buildStage();
  startGame();
}
function restart() {
  buildStage();
  startGame();
}
function roundedRectPath(c,x,y,w,h,r) {
  const rr=Math.min(r,w/2,h/2);
  c.beginPath(); c.moveTo(x+rr,y); c.arcTo(x+w,y,x+w,y+h,rr);
  c.arcTo(x+w,y+h,x,y+h,rr); c.arcTo(x,y+h,x,y,rr); c.arcTo(x,y,x+w,y,rr); c.closePath();
}
function draw() {
  if(!ctx||!maze) return;
  ctx.clearRect(0,0,frameW,frameH);
  ctx.fillStyle='#fff';ctx.fillRect(0,0,frameW,frameH);
  ctx.save();ctx.translate(-camera.x,-camera.y);
  const sx=Math.max(0,Math.floor(camera.x/cell)-1), ex=Math.min(maze.n,Math.ceil((camera.x+frameW)/cell)+1);
  const sy=Math.max(0,Math.floor(camera.y/cell)-1), ey=Math.min(maze.n,Math.ceil((camera.y+frameH)/cell)+1);
  ctx.fillStyle='#111';
  for(let y=sy;y<ey;y++) for(let x=sx;x<ex;x++)
    if(maze.grid[y][x]===1) ctx.fillRect(x*cell,y*cell,cell,cell);

  const border=Math.max(3,cell*.1);
  ctx.fillRect(0,0,worldW,border);
  ctx.fillRect(0,0,border,worldH);
  ctx.fillRect(worldW-border,0,border,worldH);
  ctx.fillRect(0,worldH-border,maze.exit.x*cell,border);
  ctx.fillRect((maze.exit.x+1)*cell,worldH-border,worldW-(maze.exit.x+1)*cell,border);

  const gx=(maze.exit.x+0.5)*cell, gy=(maze.exit.y+0.5)*cell;
  ctx.fillStyle='#111';roundedRectPath(ctx,gx-cell*.34,gy-cell*.34,cell*.68,cell*.68,cell*.07);ctx.fill();
  ctx.fillStyle='#fff';roundedRectPath(ctx,gx-cell*.24,gy-cell*.24,cell*.48,cell*.48,cell*.04);ctx.fill();
  ctx.fillStyle='#111';ctx.fillRect(gx-cell*.12,gy-cell*.12,cell*.24,cell*.24);

  ctx.beginPath();ctx.arc(ball.x,ball.y,ball.r+2,0,Math.PI*2);ctx.fillStyle='#fff';ctx.fill();
  ctx.beginPath();ctx.arc(ball.x,ball.y,ball.r,0,Math.PI*2);ctx.fillStyle='#111';ctx.fill();
  ctx.restore();
}
function tick(now) {
  requestAnimationFrame(tick);
  if(!lastFrame) lastFrame=now;
  const dt=Math.min(.033,(now-lastFrame)/1000);
  lastFrame=now;
  if(started && !paused && !cleared) {
    updatePhysics(dt);
    timerEl.textContent=fmtTime(elapsed);
    draw();
  } else if(!started) draw();
}
function handleOrientation(event) {
  if(event.gamma==null || event.beta==null) return;
  const gx=clamp(event.gamma/28,-1,1), by=clamp(event.beta/28,-1,1);
  const angle=((screen.orientation && screen.orientation.angle) ?? window.orientation ?? 0);
  const a=((angle%360)+360)%360;
  if(a===90){tiltX=by;tiltY=-gx;}
  else if(a===270){tiltX=-by;tiltY=gx;}
  else if(a===180){tiltX=-gx;tiltY=-by;}
  else {tiltX=gx;tiltY=by;}
  sensorActive=true;setMode();
}
async function enableSensor() {
  try {
    if(typeof DeviceOrientationEvent==='undefined') {
      statusEl.textContent='이 기기는 기울기 센서를 지원하지 않습니다. 방향키를 사용하세요.';
      return;
    }
    if(typeof DeviceOrientationEvent.requestPermission==='function') {
      const result=await DeviceOrientationEvent.requestPermission();
      if(result!=='granted') {
        statusEl.textContent='센서 권한이 거부되었습니다. 방향키를 사용하세요.';
        return;
      }
    }
    window.addEventListener('deviceorientation',handleOrientation,true);
    sensorActive=true;setMode();
    statusEl.textContent='센서 사용을 요청했습니다. 기기를 천천히 기울여 보세요.';
  } catch(err) {
    statusEl.textContent='센서 사용이 제한되었습니다. HTTPS에서 다시 시도하거나 방향키를 사용하세요.';
  }
}
const keys=new Set();
function refreshKeys() {
  keyX=(keys.has('ArrowRight')||keys.has('d')||keys.has('D')?1:0)-(keys.has('ArrowLeft')||keys.has('a')||keys.has('A')?1:0);
  keyY=(keys.has('ArrowDown')||keys.has('s')||keys.has('S')?1:0)-(keys.has('ArrowUp')||keys.has('w')||keys.has('W')?1:0);
  if(keyX&&keyY){keyX*=Math.SQRT1_2;keyY*=Math.SQRT1_2;}
}
window.addEventListener('keydown',e=>{
  if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' '].includes(e.key))e.preventDefault();
  keys.add(e.key);refreshKeys();
  if(e.key===' ' && !e.repeat) togglePause();
  if(e.key==='r'||e.key==='R') restart();
},{passive:false});
window.addEventListener('keyup',e=>{keys.delete(e.key);refreshKeys();});
window.addEventListener('blur',()=>{keys.clear();refreshKeys();});
startBtn.addEventListener('click',()=>{
  if(cleared){nextStage();return;}
  if(paused){overlay.hidden=true;paused=false;started=true;lastFrame=performance.now();pauseBtn.textContent='Ⅱ 일시정지';return;}
  startGame();
});
sensorBtn.addEventListener('click',enableSensor);
restartBtn.addEventListener('click',restart);
pauseBtn.addEventListener('click',togglePause);
nextBtn.addEventListener('click',nextStage);
window.addEventListener('resize',resize);
if(screen.orientation && screen.orientation.addEventListener)
  screen.orientation.addEventListener('change',()=>{});
buildStage();
resize();
setMode();
requestAnimationFrame(tick);
})();
</script>
</body>
</html>
